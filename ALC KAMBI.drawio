        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    box \&quot;Integration Layer\&quot;\n        participant Pub as _Publisher_Int\n        participant FS as _File_Server\n        participant Sub as _Subscriber_Int\n        participant EBS_Prog as _EBS_Prog_Run_Int\n    end\n\n    box \&quot;Oracle EBS\&quot;\n        participant HDR as Table XXKAMBI_TRX_HDR\n        participant LIN as Table XXKAMBI_TRX_LIN\n        participant GT as Table XLA_EVENTS_INT_GT\n        participant Proc1 as Proc CREATE_BULK_EVENTS()\n        participant EV as Table XLA_EVENTS\n        participant ENT as Table XLA_TRANSACTION_ENTITIES\n        participant Proc2 as Proc CREATE_ACCOUNTING()\n        participant GL_H as Table GL_JE_HEADERS\n        participant GL_L as Table GL_JE_LINES\n    end\n\n    Pub-&gt;&gt;FS: 1. Read File\n    activate Pub\n    FS--&gt;&gt;Pub: 2. Return File Data\n    Pub-&gt;&gt;Pub: 3. Transform Data\n    Pub-&gt;&gt;FS: 4. Write File to File Server\n    deactivate Pub\n    \n    Sub-&gt;&gt;FS: 5. Read File\n    activate Sub\n    FS--&gt;&gt;Sub: 6. Return File\n    Sub-&gt;&gt;Sub: 7. Transform Data\n    Sub-&gt;&gt;HDR: 8. PL/SQL Insert Data\n    Sub-&gt;&gt;LIN: 9. PL/SQL Insert Data\n    Sub-&gt;&gt;GT: 10. PL/SQL Insert Data\n    Sub-&gt;&gt;Proc1: 11. Invoke PL/SQL Stored Proc.\n    Proc1--&gt;&gt;EV: 12. Auto-Write Data\n    Proc1--&gt;&gt;ENT: 13. Auto-Write Data\n    Sub-&gt;&gt;EV: 14. Join/Query for Event ID\n    Sub-&gt;&gt;ENT: 15. Join/Query for Event ID\n    EV--&gt;&gt;Sub: 16. Return Event ID\n    Sub-&gt;&gt;HDR: 17. PL/SQL Insert Event ID\n    Sub-&gt;&gt;LIN: 18. PL/SQL Insert Event ID\n    Sub-&gt;&gt;Proc2: 19. Invoke the process\n    Proc2--&gt;&gt;Sub: 20. Return the Create Acct(Request ID)\n    deactivate Sub\n    \n    Proc2-&gt;&gt;GL_H: 20. Auto-Write Data\n    Proc2-&gt;&gt;GL_L: 21. Auto-Write Data&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1lJCCz7j-C9UyIxJFCqp-33">
